# TrustTrace AI Environment Configuration
# Copy this file to .env and configure as needed.

# Host & Port
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database (MongoDB connection string, defaults to persistent JSON storage if MongoDB is not accessible)
MONGO_URI=mongodb://localhost:27017/trusttrace

# Storage Path for Uploaded Evidence Documents
UPLOAD_DIR=./uploads

# AI LLM Services (Optional: deterministic analysis runs even without LLM)
# Options: "gemini", "openai", "none"
LLM_PROVIDER=none
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Retention & Security
DATA_RETENTION_DAYS=90
JWT_SECRET_KEY=trusttrace_secret_key_change_in_production
